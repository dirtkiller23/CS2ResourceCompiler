<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CS2MapCompiler.App"
             RequestedThemeVariant="Dark">
    <!-- dark is what the designer preview shows, the app itself applies the theme from the settings as it starts -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CS2MapCompiler/Theme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />

        <!-- popups inherit the cursor of the text they open from, which shows the text cursor over the copy menu -->
        <Style Selector="MenuFlyoutPresenter, MenuItem">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <!-- Fluent leaves what a button shows at its left, and buttons here have a set width to line up. Check boxes are buttons too, and keep their text beside the box -->
        <Style Selector="Button, ToggleButton, DropDownButton">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Application.Styles>
</Application>
